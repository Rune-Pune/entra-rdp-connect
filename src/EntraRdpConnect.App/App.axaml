<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EntraRdpConnect.App.App"
             xmlns:local="using:EntraRdpConnect.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentBrush" Color="#2D6CDF"/>
                    <SolidColorBrush x:Key="AccentTint" Color="#E7F0FD"/>
                    <SolidColorBrush x:Key="AmberBg" Color="#FBE7B8"/>
                    <SolidColorBrush x:Key="AmberFg" Color="#7A4E00"/>
                    <SolidColorBrush x:Key="InfoBg" Color="#E7F0FD"/>
                    <SolidColorBrush x:Key="InfoFg" Color="#14498C"/>
                    <SolidColorBrush x:Key="SuccessBg" Color="#DCF1E4"/>
                    <SolidColorBrush x:Key="SuccessFg" Color="#1B6B45"/>
                    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#E6E4DE"/>
                    <SolidColorBrush x:Key="HeroBg" Color="#F5F4F0"/>
                    <SolidColorBrush x:Key="MutedFg" Color="#6E6E6E"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentBrush" Color="#5B90EE"/>
                    <SolidColorBrush x:Key="AccentTint" Color="#1B3050"/>
                    <SolidColorBrush x:Key="AmberBg" Color="#46370F"/>
                    <SolidColorBrush x:Key="AmberFg" Color="#F3D089"/>
                    <SolidColorBrush x:Key="InfoBg" Color="#16304C"/>
                    <SolidColorBrush x:Key="InfoFg" Color="#A9CCF3"/>
                    <SolidColorBrush x:Key="SuccessBg" Color="#1C3A2A"/>
                    <SolidColorBrush x:Key="SuccessFg" Color="#7FD3A3"/>
                    <SolidColorBrush x:Key="CardBg" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#3A3A3A"/>
                    <SolidColorBrush x:Key="HeroBg" Color="#242424"/>
                    <SolidColorBrush x:Key="MutedFg" Color="#9A9A9A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <StreamGeometry x:Key="IconPlug">M16,7V3H14V7H10V3H8V7C6.9,7 6,7.9 6,9V15L9,18V21H15V18L18,15V9C18,7.9 17.1,7 16,7Z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
            <StreamGeometry x:Key="IconPhone">M17,19H7V5H17M17,1H7C5.89,1 5,1.89 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3C19,1.89 18.1,1 17,1Z</StreamGeometry>
