<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EntraRdpConnect.App.App"
             xmlns:local="using:EntraRdpConnect.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!--
                Colour carries state here, not brand. There are four meanings and no others:
                Signal = you have to do something, Ok = it cleared, Bad = it failed, Fg = you
                can press it. The previous accent blue meant "brand", "primary action" and
                "informational" at once, which put three blue things on screen competing with
                the amber moment that actually needs the user — the push approval and the
                browser sign-in. Neutrals are warm, biased towards the signal hue, so the
                palette reads as one family rather than grey with colour dropped in.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBg" Color="#FBFAF8"/>
                    <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="HeaderBg" Color="#F3F1EC"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#E4E0D8"/>
                    <SolidColorBrush x:Key="Fg" Color="#1C1A17"/>
                    <SolidColorBrush x:Key="OnFg" Color="#FBFAF8"/>
                    <SolidColorBrush x:Key="MutedFg" Color="#6B655C"/>
                    <SolidColorBrush x:Key="SignalBg" Color="#FCF0D6"/>
                    <SolidColorBrush x:Key="SignalFg" Color="#8A5200"/>
                    <SolidColorBrush x:Key="SignalDot" Color="#C77800"/>
                    <SolidColorBrush x:Key="OkBg" Color="#E3F1E9"/>
                    <SolidColorBrush x:Key="OkFg" Color="#1E6A47"/>
                    <SolidColorBrush x:Key="OkDot" Color="#2E8B5F"/>
                    <SolidColorBrush x:Key="BadBg" Color="#FBE7E4"/>
                    <SolidColorBrush x:Key="BadFg" Color="#9B2018"/>
                    <SolidColorBrush x:Key="QuietBg" Color="#EFEDE7"/>
                    <!-- Fluent derives focus rings, carets and text selection from the system
                         accent, which on most desktops is a blue we have just spent the whole
                         redesign removing. Ink keeps those affordances visible without
                         reintroducing a fifth meaning. -->
                    <Color x:Key="SystemAccentColor">#1C1A17</Color>
                    <Color x:Key="SystemAccentColorLight1">#3A3630</Color>
                    <Color x:Key="SystemAccentColorLight2">#57524A</Color>
                    <Color x:Key="SystemAccentColorLight3">#6B655C</Color>
                    <Color x:Key="SystemAccentColorDark1">#141210</Color>
                    <Color x:Key="SystemAccentColorDark2">#0E0D0B</Color>
                    <Color x:Key="SystemAccentColorDark3">#080706</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBg" Color="#171614"/>
                    <SolidColorBrush x:Key="SurfaceBg" Color="#201E1B"/>
                    <SolidColorBrush x:Key="HeaderBg" Color="#1E1D1A"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#33302B"/>
                    <SolidColorBrush x:Key="Fg" Color="#F2EFE9"/>
                    <SolidColorBrush x:Key="OnFg" Color="#171614"/>
                    <SolidColorBrush x:Key="MutedFg" Color="#A29B90"/>
                    <SolidColorBrush x:Key="SignalBg" Color="#3B2C10"/>
                    <SolidColorBrush x:Key="SignalFg" Color="#F0B429"/>
                    <SolidColorBrush x:Key="SignalDot" Color="#F0B429"/>
                    <SolidColorBrush x:Key="OkBg" Color="#16301F"/>
                    <SolidColorBrush x:Key="OkFg" Color="#6FCF97"/>
                    <SolidColorBrush x:Key="OkDot" Color="#6FCF97"/>
                    <SolidColorBrush x:Key="BadBg" Color="#3A1A17"/>
                    <SolidColorBrush x:Key="BadFg" Color="#F0A79E"/>
                    <SolidColorBrush x:Key="QuietBg" Color="#232120"/>
                    <Color x:Key="SystemAccentColor">#F2EFE9</Color>
                    <Color x:Key="SystemAccentColorLight1">#F7F5F1</Color>
                    <Color x:Key="SystemAccentColorLight2">#FBFAF8</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#C9C3B9</Color>
                    <Color x:Key="SystemAccentColorDark2">#A29B90</Color>
                    <Color x:Key="SystemAccentColorDark3">#7B7469</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Two type registers: sentences in the UI face, machine identifiers in mono.
                DejaVu and Liberation are the two mono faces present on effectively every
                Linux desktop, so the fallback chain lands somewhere real rather than on
                whatever the toolkit picks by default.
            -->
            <FontFamily x:Key="MonoFont">Cascadia Code,JetBrains Mono,DejaVu Sans Mono,Liberation Mono,monospace</FontFamily>

            <!--
                Fluent draws the selected tab with an accent-coloured pipe and sets the header
                at display size. Rather than chase its internal resource keys, the tab strip
                owns its own template: a quiet underline in the text colour, at a size that
                labels the content instead of shouting over it.
            -->
            <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
                <Setter Property="Padding" Value="10,9"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_LayoutRoot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Style>
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
                <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="BorderBrush" Value="{DynamicResource Fg}"/>
                </Style>
            </ControlTheme>

            <StreamGeometry x:Key="IconPlug">M16,7V3H14V7H10V3H8V7C6.9,7 6,7.9 6,9V15L9,18V21H15V18L18,15V9C18,7.9 17.1,7 16,7Z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
            <StreamGeometry x:Key="IconPhone">M17,19H7V5H17M17,1H7C5.89,1 5,1.89 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3C19,1.89 18.1,1 17,1Z</StreamGeometry>
            <StreamGeometry x:Key="IconWeb">M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,19.96C11.17,18.76 10.5,17.43 10.09,16H13.91C13.5,17.43 12.83,18.76 12,19.96M8,8H5.08C6.03,6.34 7.57,5.06 9.4,4.44C8.8,5.55 8.35,6.75 8,8M5.08,16H8C8.35,17.25 8.8,18.45 9.4,19.56C7.57,18.93 6.03,17.65 5.08,16M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14M12,4.03C12.83,5.23 13.5,6.57 13.91,8H10.09C10.5,6.57 11.17,5.23 12,4.03M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
            <StreamGeometry x:Key="IconShield">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7A2,2 0 0,1 14,9A2,2 0 0,1 12,11A2,2 0 0,1 10,9A2,2 0 0,1 12,7M12,12C13,12 14,13 14,14V17H10V14C10,13 11,12 12,12Z</StreamGeometry>
            <StreamGeometry x:Key="IconWarn">M13,14H11V9H13M13,18H11V16H13M1,21H23L12,2L1,21Z</StreamGeometry>
            <StreamGeometry x:Key="IconChevron">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</StreamGeometry>
            <StreamGeometry x:Key="IconCog">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>

        <!-- The primary action is monochrome. It stays the highest-contrast thing on a quiet
             screen without spending the signal colour on a button that is almost always idle. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Fg}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fg}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnFg}"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fg}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnFg}"/>
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource QuietBg}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource MutedFg}"/>
        </Style>

        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.quiet /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource MutedFg}"/>
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource QuietBg}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource Fg}"/>
        </Style>

        <!-- Buttons that live inside a coloured banner inherit that banner's meaning, so they
             borrow its foreground rather than introducing a third colour. -->
        <Style Selector="Button.inline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.inline /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>

        <!-- The log is a place to look when something went wrong, not an action. Fluent's
             Expander draws its header as a full-width raised box, which put a second thing
             the same size and weight as the primary button right underneath it. -->
        <Style Selector="ToggleButton.disclosure">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
        </Style>
        <Style Selector="ToggleButton.disclosure /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource MutedFg}"/>
        </Style>
        <Style Selector="ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource MutedFg}"/>
        </Style>
        <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style Selector="ToggleButton.disclosure:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource Fg}"/>
        </Style>

        <!-- The step rail. A pip is unlit by default; the classes below are bound to the
             step's state, so the rail is the only place the eye has to go to answer
             "where am I, and is it waiting for me?". -->
        <Style Selector="Border.pip">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Border.pip.current">
            <Setter Property="BorderBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderThickness" Value="2.5"/>
        </Style>
        <Style Selector="Border.pip.needsYou">
            <Setter Property="Background" Value="{DynamicResource SignalDot}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SignalDot}"/>
        </Style>
        <Style Selector="Border.pip.done">
            <Setter Property="Background" Value="{DynamicResource OkDot}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OkDot}"/>
        </Style>

        <Style Selector="TextBlock.stepLabel">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.stepLabel.lit">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TextBlock.stepLabel.needsYou">
            <Setter Property="Foreground" Value="{DynamicResource SignalFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Settings group headings. The rule after the label is drawn by the layout, not by
             a border on the label itself, so a long translation pushes the rule instead of
             wrapping under it. -->
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Styles>
</Application>
