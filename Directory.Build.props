<Project>

  <!--
    Analysenivå. «Recommended» er målt til null advarsler på koden slik den står, så dette
    koster ingenting i dag — poenget er å låse standarden for det som kommer senere, også
    fra bidrag utenfra. CI bygger med -warnaserror, så en ny advarsel stopper en PR.

    «All» er bevisst valgt bort: det gir ~330 advarsler, dominert av CA1707 (understrek i
    identifikatorer, altså de beskrivende testnavnene våre) og CA2007 (ConfigureAwait, en
    biblioteksregel som ikke gjelder en desktop-app). Nivået ville kostet en kveld med
    undertrykkinger uten å gjøre koden bedre.
  -->
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Appen orkestrerer Linux-spesifikke verktøy (pkexec, uwg-quick, xfreerdp3 under en
    pseudo-terminal) og bruker Unix-filrettigheter. Vi merker derfor alle prosjektene som
    Linux-only, så analysatoren slutter å advare om at f.eks. File.SetUnixFileMode ikke
    finnes på Windows. Uten dette drukner reelle advarsler i støy.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
